 from mcp.server.fastmcp import FastMCP
 
 mcp = FastMCP("skill-mcp-demo")
 
+
+RISK_KEYWORDS = {
+    "eval(": "Avoid eval on untrusted input.",
+    "exec(": "Avoid exec on untrusted input.",
+    "shell=True": "shell=True can introduce command injection risk.",
+    "subprocess.": "Review subprocess usage and argument handling.",
+    "except:": "Bare except may hide real failures.",
+    "pickle.loads": "pickle.loads can execute arbitrary code.",
+}
+
+
+def _changed_lines(diff: str) -> list[str]:
+    """Return added lines, excluding diff metadata."""
+    lines = []
+    for line in diff.splitlines():
+        if line.startswith("+++") or not line.startswith("+"):
+            continue
+        lines.append(line[1:])
+    return lines
+
+
+def _changed_files(diff: str) -> list[str]:
+    """Extract changed file paths from a git diff."""
+    files = []
+    for line in diff.splitlines():
+        if not line.startswith("diff --git "):
+            continue
+        parts = line.split()
+        if len(parts) >= 4:
+            files.append(parts[3].removeprefix("b/"))
+    return files
+
+
+def _summarize_diff(diff: str) -> dict[str, object]:
+    """Compute a small summary that is useful for a review report."""
+    added = 0
+    removed = 0
+    for line in diff.splitlines():
+        if line.startswith("+++") or line.startswith("---"):
+            continue
+        if line.startswith("+"):
+            added += 1
+        elif line.startswith("-"):
+            removed += 1
+
+    files = _changed_files(diff)
+    suffixes = Counter(file.rsplit(".", 1)[-1] for file in files if "." in file)
+    return {
+        "files": files,
+        "added": added,
+        "removed": removed,
+        "suffixes": suffixes,
+    }
+
 
 @mcp.tool()
 def review_code_diff(
